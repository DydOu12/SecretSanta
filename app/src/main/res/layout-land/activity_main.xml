<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.dylan.randomnoel.MainActivity">

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajouter"
        android:id="@+id/valider"
        android:onClick="ajouter"
        android:layout_below="@+id/groupe"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="49dp" />

    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/listeNoms"
        android:layout_toStartOf="@+id/textView"
        android:layout_alignTop="@+id/nom" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Random"
        android:id="@+id/random"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/textView3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="Prenom"
        android:id="@+id/textView"
        android:layout_above="@+id/groupe"
        android:layout_toStartOf="@+id/valider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="Groupe"
        android:id="@+id/textView3"
        android:layout_alignBottom="@+id/groupe"
        android:layout_alignStart="@+id/textView" />

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/nom"
        android:layout_alignParentEnd="true"
        android:layout_alignStart="@+id/valider" />

    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:ems="10"
        android:id="@+id/groupe"
        android:layout_below="@+id/nom"
        android:layout_toEndOf="@+id/textView3"
        android:layout_alignStart="@+id/nom" />

</RelativeLayout>
