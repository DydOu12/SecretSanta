<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/idLi"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_badge"
            android:gravity="center"
            android:text="@string/idL"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nomContactInList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/idLi"
            android:layout_toStartOf="@+id/numGroupe"
            android:autofillHints="name"
            android:background="@null"
            android:inputType="text"
            android:paddingVertical="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="LabelFor"
            tools:text="Jean Dupont" />

        <TextView
            android:id="@+id/numGroupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/suppr"
            android:background="?attr/colorPrimaryContainer"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/num_group"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="13sp"
            tools:text="Gr. 1" />

        <ImageView
            android:id="@+id/suppr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/suppr"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorError" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>